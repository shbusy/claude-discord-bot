# ── Discord (필수) ──
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# 개발용 길드 ID (비우면 글로벌 명령으로 등록, 전파에 최대 1시간)
DISCORD_GUILD_ID=

# 화이트리스트 (콤마 구분 user ID). 비우면 부팅 거부.
ALLOWED_USER_IDS=

# ── Claude CLI ──
CLAUDE_BIN=claude
DEFAULT_MODEL=sonnet
PERMISSION_MODE=default
DEFAULT_LANG=ko

# thinking 언어 강제 (off | ko | en ...). thinking은 출력 토큰이라 한국어로 강제하면 비용이 늘어난다
THINKING_LANG=off
# true면 봇을 @멘션한 메시지에만 반응한다
REQUIRE_MENTION=false

# 기본 작업 디렉토리 (비우면 $HOME)
# Discord에서 지정하는 세션 경로와 브라우저 탐색은 이 경로 아래로 제한된다.
DEFAULT_CWD=

# runner idle 종료 시간 (ms, 기본 300000 = 5분)
IDLE_TIMEOUT_MS=3300000

# ── 데이터/로그 ──
# 데이터·로그·플러그인 디렉토리 (기본: ~/.claude-discord-bot)
CDB_HOME=
LOG_LEVEL=info

# ── 외부 CLI ──
# gws (Google Workspace CLI): 봇 자식 프로세스에서 macOS 키체인 접근이 막혀
# auth_method=none으로 떨어지므로 파일 백엔드를 강제한다.
# 이 값을 바꾸면 `GOOGLE_WORKSPACE_CLI_KEYRING_BACKEND=file gws auth login`으로 재인증 필요.
GOOGLE_WORKSPACE_CLI_KEYRING_BACKEND=file
