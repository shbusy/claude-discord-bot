{
  "name": "claude-discord-bot",
  "version": "0.0.1",
  "private": true,
  "description": "Self-hosted Discord bot that delegates to a local claude CLI session.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "cdb": "./dist/bin/cdb.js"
  },
  "scripts": {
    "dev": "tsx bin/cdb.ts",
    "setup": "tsx bin/cdb.ts setup",
    "doctor": "tsx bin/cdb.ts doctor",
    "e2e:manual": "tsx bin/cdb.ts e2e-manual",
    "register": "tsx bin/cdb.ts register",
    "run:bot": "tsx bin/cdb.ts run",
    "start": "node dist/bin/cdb.js run",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "npm run typecheck && npm test && npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.141",
    "better-sqlite3": "^11.7.0",
    "chokidar": "^4.0.1",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "p-queue": "^8.0.1",
    "pino": "^9.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
