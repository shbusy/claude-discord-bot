{
  "name": "claude-discord-bot",
  "version": "0.0.1",
  "private": true,
  "description": "Self-hosted Discord bot that delegates to a local claude CLI session.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "cdb": "./dist/bin/cdb.js"
  },
  "scripts": {
    "dev": "tsx bin/cdb.ts",
    "start": "node dist/bin/cdb.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "chokidar": "^4.0.1",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "p-queue": "^8.0.1",
    "pino": "^9.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
